#!/usr/bin/env python3
"""Hotkey helper -- bound to Super+Space.

Imports nothing heavier than `socket` on purpose. This runs on every press of
the hotkey, and importing gi here would put a quarter of a second between the
key going down and the card appearing.
"""

import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import ipc  # noqa: E402

if not ipc.send("toggle"):
    # Nothing listening, so Ember isn't up. Start it already open, rather than
    # making the user press the hotkey a second time.
    app = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ember.py")
    subprocess.Popen(
        [sys.executable, app, "--open"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
